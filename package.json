{
  "name": "dsh-three-level-agent",
  "version": "1.0.0",
  "description": "三级代理插件 for DeepSeek Harness: three-level subagent delegation (1x9x9) with tree-wide async agent messaging and a web UI tree panel",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "three-level-agents", "multi-agent", "subagents", "agent-orchestration", "ai-agents"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntheaLaffy/dsh-three-level-agent.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "README.md", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
